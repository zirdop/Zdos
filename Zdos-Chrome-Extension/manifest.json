{
  "manifest_version": 3,
  "name": "Zdos",
  "version": "1.0.0",
  "description": "Console Toolkit",
  "action": {
    "default_title": "Zdos",
    "default_popup": "popup.html"
  },
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {}
}